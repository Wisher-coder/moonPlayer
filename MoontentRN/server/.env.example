# moonPlayer 后端环境变量样例
# 复制为 .env 使用：cp .env.example .env（全部变量均有内置默认，可整文件省略）
# 上游站点入口轮换频繁；站点失败时先跑 Nodejs/<site>.js 取证 CLI 查最新地址再覆盖。

# ── 站点入口覆盖（留空 = 内置默认 / 发布页自动解析） ──
YS_API_TARGET=
AVJB_BASE=
AIDOU_BASE=
HXC_GATEWAY=
# 含羞草登录态 token（可选，VIP 专享片直读用；游客态留空）
HXC_TOKEN=
ZMQ_BASE=
# 字母圈会员态 Cookie 头（可选，VIP/金币片真实播放用；游客态留空，勿提交真实值）
ZMQ_COOKIE=
DSD_BASE=
BF_BASE=
P91_BASE=
LLW_BASE=
ZIYUANZU_URL=

# ── Telegram 账号源（到 my.telegram.org「API development tools」申请） ──
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# SOCKS5 出口代理：socks5://[user:pass@]host:port（可选，留空直连）
TELEGRAM_PROXY=
# MTProto 会话串直填（等同账号密码，勿入库）；会话文件路径默认 server/.telegram-session.json
TELEGRAM_SESSION=
TELEGRAM_SESSION_FILE=

# ── Telegram 媒体调度（详见 README「Telegram 视频提速」） ──
# 每 DC 媒体会话数（默认 16）× 每会话在途请求数（默认 4）
TG_MEDIA_SESSIONS=
TG_MEDIA_INFLIGHT=
TG_MEDIA_CONCURRENCY=
# 分片端口数（默认 9，0 关闭）
TG_SHARD_PORTS=
# 并发活跃视频流上限（默认 16）
TG_STREAM_SLOTS=

# ── 收藏库（MySQL + Redis 热缓存；Redis 连不上自动静默降级直查 MySQL） ──
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=moontent
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# ── 服务 ──
PORT=3001
# 前端静态产物目录（生产托管用，见 README「生产部署」）
SERVE_DIST=
